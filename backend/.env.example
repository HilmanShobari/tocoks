# Hanya untuk backend tocoks. Tidak dibaca frontend atau Afihub.
STOREFRONT_HOST=127.0.0.1
STOREFRONT_PORT=8120
STOREFRONT_SYNC_INTERVAL_SECONDS=15
STOREFRONT_DB_PATH=data/orders.sqlite
# Isi secret key TEST Xendit milik brand (xnd_development_...).
STOREFRONT_XENDIT_API_KEY=
# Opsional karena status invoice juga dipolling langsung ke Xendit.
STOREFRONT_XENDIT_CALLBACK_TOKEN=
# Secret server brand untuk endpoint perubahan status. Jangan pakai VITE_.
STOREFRONT_ADMIN_TOKEN=
# Optional Afihub SDK integration. Fill all three values from Brand Portal.
AFIHUB_MERCHANT_ID=
AFIHUB_WEBHOOK_SECRET=
AFIHUB_CONVERSION_URL=
